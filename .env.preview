# ===========================================
# 应用配置 (预览环境)
# ===========================================

# 预览环境标识
NODE_ENV=preview

# 预览环境基础 URL (Vercel 会自动设置)
VITE_APP_URL=https://your-app-preview.vercel.app

# ===========================================
# 功能开关 (预览环境)
# ===========================================

# 启用调试模式
VITE_DEBUG=true

# 启用模拟数据 (用于演示)
VITE_MOCK_DATA=true

# 日志级别
LOG_LEVEL=debug

# ===========================================
# 安全配置 (预览环境)
# ===========================================

# 预览环境使用较宽松的安全策略
VITE_ENABLE_STRICT_MODE=false

# 允许开发工具
VITE_ENABLE_DEV_TOOLS=true