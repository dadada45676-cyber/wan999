# 安全配置
VITE_SESSION_TIMEOUT=3600000
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_LOCKOUT_DURATION=900000
VITE_ENABLE_CSRF_PROTECTION=true
VITE_SECURE_COOKIES=true

# 性能配置
VITE_ENABLE_COMPRESSION=true
VITE_ENABLE_CACHE=true
VITE_CACHE_DURATION=3600
VITE_ENABLE_LAZY_LOADING=true

# 监控配置
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# 调试配置 - 生产环境
VITE_ENABLE_NETWORK_DIAGNOSTICS=false
VITE_DEBUG_API_CALLS=false
VITE_ENABLE_CONSOLE_LOGS=false
VITE_ENABLE_SOURCE_MAPS=false

# 构建优化
VITE_ENABLE_TREE_SHAKING=true
VITE_ENABLE_MINIFICATION=true
VITE_ENABLE_GZIP=true

# 部署配置
VITE_DEPLOYMENT_TARGET=vercel
VITE_DEPLOYMENT_REGION=hkg1

# 管理员账户配置 (生产环境)
ADMIN_EMAIL=admin@sms-system.com
ADMIN_PASSWORD=Admin123!@#

# 数据库配置
VITE_DB_POOL_SIZE=20
VITE_DB_TIMEOUT=30000

# 文件上传配置
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=.txt,.csv,.xlsx

# 短信配置
VITE_SMS_RATE_LIMIT=1000
VITE_SMS_BATCH_SIZE=100

# 缓存配置
VITE_REDIS_TTL=3600
VITE_MEMORY_CACHE_SIZE=100

# 日志配置
VITE_LOG_LEVEL=error
VITE_LOG_RETENTION_DAYS=30