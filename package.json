{
  "name": "trae-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:preview": "NODE_ENV=preview tsc -b && vite build",
    "build:production": "NODE_ENV=production node scripts/build-production.js",
    "build:safe": "node scripts/build-production.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "preview:local": "vite preview --port 4173",
    "check": "tsc -b --noEmit",
    "type-check": "tsc -b --noEmit",
    "clean": "rm -rf dist node_modules/.vite",
    "security-check": "node scripts/security-check.js",
    "deploy:preview": "vercel --env .env.preview",
    "deploy:production": "npm run build:safe && vercel --prod",
    "deploy:quick": "bash scripts/quick-deploy.sh",
    "deploy:quick:preview": "bash scripts/quick-deploy.sh preview",
    "deploy:quick:production": "npm run build:safe && bash scripts/quick-deploy.sh production",
    "setup:vercel": "node scripts/setup-vercel.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.75.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.3.0",
    "recharts": "^3.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-trae-solo-badge": "^1.0.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
